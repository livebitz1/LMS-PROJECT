generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  clerkId         String          @unique
  email           String          @unique
  name            String?
  firstName       String?
  lastName        String?
  profileImageUrl String?
  createdAt       DateTime        @default(now())
  role            String?
  courses         Course[]
  teacherProfile  TeacherProfile?
  teacherBookingsAsTeacher TeacherBooking[] @relation("TeacherBookingsAsTeacher")
  teacherBookingsAsStudent TeacherBooking[] @relation("TeacherBookingsAsStudent")
}

model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  createdAt    DateTime @default(now())
  instructorId String
  instructor   User     @relation(fields: [instructorId], references: [id])
  lessons      Lesson[]
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  content   String?
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
}

model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  degree          String?
  experienceYears Int?
  subjects        Json?
  skills          Json?
  linkedin        String?
  profileImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  displayName     String?
  hourlyRate      Float?
  user            User     @relation(fields: [userId], references: [id])
}

model TeacherBooking {
  id           String   @id @default(cuid())
  teacherId    String
  studentId    String
  studentName  String
  studentEmail String
  message      String?
  createdAt    DateTime @default(now())
  teacher      User     @relation("TeacherBookingsAsTeacher", fields: [teacherId], references: [id])
  student      User     @relation("TeacherBookingsAsStudent", fields: [studentId], references: [id])
}
